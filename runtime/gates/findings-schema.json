{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lava-agent-findings",
  "title": "Agent specialist findings",
  "type": "object",
  "required": ["agent", "findings"],
  "additionalProperties": true,
  "properties": {
    "agent": { "type": "string" },
    "verdict_native": { "type": "string" },
    "ran_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "what"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "nit"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "what": { "type": "string" },
          "failure": { "type": "string" },
          "evidence": { "type": "string" },
          "fix": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "class": {
            "type": "string",
            "enum": [
              "parity",
              "safety",
              "security",
              "gate-weakening",
              "memory-safety",
              "perf",
              "style",
              "other"
            ],
            "description": "Drives the severity floor. parity, safety, security, gate-weakening and memory-safety can never be P2 — aggregate-verdict.mjs raises them to P1. The rest are informational. Unconstrained before, and the vocabulary had already drifted: memory-safety was floored by the aggregator and named nowhere here, so an auditor reading this file did not know the class existed."
          }
        }
      }
    }
  }
}
