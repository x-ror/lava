# Dependencies and local caches
# No trailing slash: a worktree may use a node_modules symlink (agent-cycle F2)
# and `.gitignore` with a trailing slash matches only directories.
node_modules
.deps/
tests/vendor/

# Ephemeral fixtures written by node-compat cases (pid-suffixed); never commit
tests/node-compat/fixtures/*.tmp
tests/node-compat/fixtures/*-tmp/
tests/node-compat/fixtures/wrapper-escape-tmp*/
tests/node-compat/fixtures/nm-tmp*/
tests/node-compat/fixtures/typed-array-offset*.tmp

# Build outputs
bin/
build/
reports/
*.bin
*.dll
*.dylib
*.exe
*.a
*.o
*.so

# Odin test binaries emitted at the repo root by make test-* targets.
/eventloop
/lava

# Mirrored upstream Node.js API docs — regenerable via scripts/node-compat/fetch-node-docs.py
# (only SOURCE.txt, which pins the commit, is tracked)
/reference/node-doc-api/*.md

# graphify knowledge-graph build output — regenerate with `graphify update`
graphify-out/

# Local secrets — never commit
.env
.env.*
!.env.example

# Agent-cycle driver local state (issue plans, locks)
.agent-cycle/
.agent-state/
.agent-prompt.txt
.agent-prompt-*.txt
