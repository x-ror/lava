{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make check-cli)",
      "Bash(make check-runtime)",
      "Bash(make check-js)",
      "Bash(make check-md)",
      "Bash(make fix-md)",
      "Bash(make check-actions)",
      "Bash(make check-primordials)",
      "Bash(make check-jsc)",
      "Bash(make check-native)",
      "Bash(make fmt)",
      "Bash(make build)",
      "Bash(make native-deps)",
      "Bash(make test)",
      "Bash(make test:*)",
      "Bash(make test-lava)",
      "Bash(make bench)",
      "Bash(make bench:*)",
      "Bash(make bench-gate)",
      "Bash(make api-surface)",
      "Bash(make bun-buffer-tests)",
      "Bash(make help)",
      "Bash(odin check:*)",
      "Bash(odin test:*)",
      "Bash(odin build:*)",
      "Bash(odin version)",
      "Bash(odin strip-semicolon:*)",
      "Bash(node:*)",
      "Bash(bun run js:*)",
      "Bash(vp run:*)",
      "Bash(./bin/lava:*)",
      "Bash(./scripts/run-:*)",
      "Bash(./commands/:*)",
      "Bash(./workflows/:*)",
      "Bash(./runtime/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",
      "Bash(git blame:*)",
      "Bash(git stash list)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(pkg-config:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.grok/hooks/**)",
      "Edit(runtime/gates/integrity.mjs)",
      "Edit(runtime/gates/case-counts.json)",
      "Edit(runtime/gates/assert-case-counts.mjs)",
      "Edit(scripts/lib/compare.sh)",
      "Edit(scripts/lib/primordials-baseline.mjs)",
      "Edit(scripts/lib/primordials-detect.mjs)",
      "Edit(scripts/lib/primordials-fixtures.mjs)",
      "Edit(scripts/check-primordials.mjs)",
      "Edit(scripts/run-mutations.mjs)",
      "Edit(scripts/run-node-compat-all.sh)",
      "Edit(scripts/run-eventloop-oracle.sh)",
      "Edit(scripts/run-fs-oracle.sh)",
      "Edit(scripts/run-sqlite-oracle.sh)",
      "Edit(bench/run.mjs)",
      "Edit(bench/thresholds.json)",
      "Edit(tests/mutation-manifest.json)",
      "Edit(tests/node-compat/pollution-baseline.json)",
      "Edit(tests/node-compat/known-lava-gaps.txt)",
      "Edit(tests/runtime/eventloop/known-lava-gaps.txt)",
      "Edit(Makefile)",
      "Edit(package.json)",
      "Edit(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|search_replace|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-integrity.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
