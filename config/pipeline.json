{
  "name": "feature-pipeline",
  "description": "New task → planner → odin-feature → critic → gates → pr-gate → (fixer loop) → Create PR. PR only after pr-gate SHIP/SHIP-AFTER. Never merge.",
  "triggers": [
    { "type": "issue.labeled", "labels": ["agent-ready", "lava-ready"] },
    { "type": "issue.opened", "require_lava_task": true },
    { "type": "schedule", "interval": "30m", "action": "drain-ready" },
    {
      "type": "pr.comment",
      "commands": ["/odin-feature", "/pr-gate", "/fixer", "/critic", "/run-pipeline"]
    },
    { "type": "gate.failure", "action": "fixer" },
    { "type": "manual", "entry": "commands/index.mjs run-pipeline" }
  ],
  "//triggers": "Documentation of what .github/workflows/agent-system.yml is wired to fire. Nothing reads this block at runtime — the workflow file is the executable copy, and workflows/triggers/*.mjs are the handlers.",
  "graph": {
    "entry": "select",
    "nodes": {
      "select": { "type": "system", "next": "planner" },
      "planner": {
        "type": "command",
        "command": "planner",
        "next": "odin-feature",
        "on_fail": "terminal.needs-human"
      },
      "odin-feature": {
        "type": "command",
        "command": "odin-feature",
        "isolation": "worktree",
        "next": "critic",
        "on_fail": "fixer"
      },
      "critic": {
        "type": "command",
        "command": "critic",
        "next": "gates",
        "on_fail": "gates"
      },
      "gates": {
        "type": "system",
        "action": "gates",
        "next": "pr-gate",
        "//": "The pipeline runs the routed mechanical gates itself. pr-gate runs them too, but that run is self-reported by the agent; this one is the trust boundary and is what sets gateRed for the verdict aggregator. Red routes to fixer via forceNext."
      },
      "pr-gate": {
        "type": "command",
        "command": "pr-gate",
        "hard_gate": true,
        "on_ship": "create-pr",
        "on_ship_after": "create-pr",
        "on_block": "fixer",
        "//": "Fail-closed: anything that is not a machine-readable SHIP / SHIP-AFTER takes on_block, including a crash, a turn-limit exit, or a run under provider `none`. See workflows/engine.test.mjs."
      },
      "fixer": {
        "type": "command",
        "command": "fixer",
        "max_rounds": 3,
        "next": "gates",
        "on_stall": "terminal.needs-human"
      },
      "create-pr": { "type": "system", "action": "draft_pr", "next": "terminal.done" },
      "terminal.done": { "type": "terminal", "status": "done" },
      "terminal.needs-human": { "type": "terminal", "status": "needs-human-decision" }
    }
  },
  "policy": {
    "max_fix_rounds": 3,
    "stall_if_no_open_count_drop": 2,
    "never_merge": true,
    "never_self_waive_p1": true,
    "worktree_outside_main": true,
    "forbid_git_stash": true
  }
}
